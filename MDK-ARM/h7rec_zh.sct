; STM32H743 scatter-loading 文件，中文注释版。
;
; 这个文件用于告诉 armlink：每个输入 section 从哪里加载，以及运行时放到哪里。
; 当前工程的完整镜像都从片内 Flash 加载；位于 RAM 的执行区会在进入 main()
; 之前由 C 运行库完成拷贝或清零。
;
; 本文件是阅读用中文版本。当前 Keil 工程仍然引用 MDK-ARM/h7rec.sct。
; 如果要把本文件作为正式链接脚本使用，需要在 Keil 工程配置中修改 Scatter File。
;
; 请让本文件和下面两个文件保持一致：
;   Drivers/CMSIS/Device/ST/STM32H7xx/Include/stm32h743xx.h
;   MDK-ARM/startup_stm32h743xx.s
;
; ---------------------------------------------------------------------------------------------------
; 字符版内存布局图
; ---------------------------------------------------------------------------------------------------
;
; 说明：
;   这是一张连续纵向总图：高地址在上，低地址在下。
;   地址空间本身不是完全连续的，每一块物理内存之间用 ----- 分隔。
;   Cortex-M 栈向低地址增长，所以 STACK 画在 DTCM 的高地址端。
;   ITCM、DTCM、AXI、AHB 标记表示 CPU/外设访问该内存时使用的主要总线或 TCM 类型。
;
;   高地址
;      ^
;      |
;   0x38800FFF  +----------------+
;               | D3 BKPSRAM 4KB |
;               | .bkpsram*      |
;   0x38800000  +----------------+
;               ------------------
;   0x3800FFFF  +----------------+
;               | D3 SRAM 64KB   |
;               | AHB SRAM       |
;               | .d3_sram*      |
;   0x38000000  +----------------+
;               ------------------
;   0x30047FFF  +----------------+
;               | D2 SRAM 288KB  |
;               | AHB 地址       |
;               | .d2_sram*      |
;               | DMA/外设共享   |
;   0x30000000  +----------------+
;               ------------------
;   0x2407FFFF  +----------------+
;               | AXI SRAM       |
;               | HEAP 128KB     |
;   0x24060000  +----------------+
;   0x2405FFFF  | AXI SRAM       |
;               | RW/ZI 数据     |
;               | .noncacheable  |
;               | 384KB          |
;   0x24000000  +----------------+
;               ------------------
;   0x2001FFFF  +----------------+
;               | DTCM RAM       |
;               | STACK 16KB     |
;               | 向低地址增长   |
;   0x2001C000  +----------------+
;   0x2001BFFF  | DTCM RAM       |
;               | 预留 DTCM      |
;               | .dtcm_data*    |
;               | CPU 专用高速数据 |
;   0x20000000  +----------------+
;               ------------------
;   0x10047FFF  +----------------+
;               | D2 SRAM 别名   |
;               | AXI 地址       |
;               | 同一块 D2 SRAM |
;   0x10000000  +----------------+
;               ------------------
;   0x081FFFFF  +----------------+
;               | AXI Flash      |
;               | ER_IROM1       |
;               | 向量表 RESET   |
;               | 代码           |
;               | 只读常量       |
;               | XO 代码        |
;               | 最大 2MB       |
;   0x08000000  +----------------+
;               ------------------
;   0x0000FFFF  +----------------+
;               | ITCM RAM 64KB  |
;               | .itcm_text*    |
;               | 可选热点代码   |
;   0x00000000  +----------------+
;      |
;      v
;   低地址
;
; ---------------------------------------------------------------------------------------------------
; 本工程使用的 STM32H743 内存地图
; ---------------------------------------------------------------------------------------------------
;
; Flash，D1 域：
;   D1_AXIFLASH_BASE  0x08000000  0x00200000  2MB 片内 Flash
;     用于放置中断向量表、代码、只读常量，以及 RAM 数据的加载镜像。
;     Bank1 范围是 0x08000000-0x080FFFFF，Bank2 范围是 0x08100000-0x081FFFFF。
;
; 紧耦合内存，D1 域：
;   D1_ITCMRAM_BASE   0x00000000  0x00010000   64KB ITCM RAM
;     指令 TCM。适合放极少量、特别热点、要求极低延迟执行的代码。
;     放到这里的代码会同时占用 Flash 加载空间和 ITCM 运行空间。
;
;   D1_DTCMRAM_BASE   0x20000000  0x00020000  128KB DTCM RAM
;     数据 TCM。Cortex-M7 内核访问很快，但很多 DMA 主机不能访问。
;     不要把 USB、SDMMC、ETH、DMA 或其他外设缓冲区放在这里。
;     本工程把 DTCM 顶部 16KB 保留给启动/主栈。
;
;   D1_AXISRAM_BASE   0x24000000  0x00080000  512KB AXI SRAM
;     本工程主要使用的通用 SRAM。CPU 和 DMA 总线主机都可以访问，
;     因此默认 RW/ZI 数据和 USB 缓冲区都放在这里。
;     本文件把 AXI SRAM 分成两段：
;       0x24000000-0x2405FFFF  384KB  默认 RW/ZI 和 .noncacheable*
;       0x24060000-0x2407FFFF  128KB  startup_stm32h743xx.s 中定义的 C/C++ heap
;
; D2/D3 SRAM：
;   D2_AXISRAM_BASE   0x10000000  0x00048000  288KB D2 SRAM 别名地址
;   D2_AHBSRAM_BASE   0x30000000  0x00048000  288KB D2 SRAM AHB 地址
;     D2 SRAM 适合显式放置 DMA 缓冲区或与外设共享的数据。
;     如果外设或 DMA 期望 AHB 地址，优先使用 0x30000000 这个别名。
;
;   D3_SRAM_BASE      0x38000000  0x00010000   64KB D3 SRAM
;     适合低功耗场景或需要明确放到 D3 域的数据。
;     当前工程默认不把普通数据放到这里。
;
;   D3_BKPSRAM_BASE   0x38800000  0x00001000    4KB Backup SRAM
;     在正确配置备份电源和备份域访问权限后，可用于部分复位或低功耗模式下的数据保持。
;
; ---------------------------------------------------------------------------------------------------
; 当前启用的 section 命名约定
; ---------------------------------------------------------------------------------------------------
;
;   .noncacheable*
;     用于把 USB/DMA 相关对象集中放到 AXI SRAM。
;     注意：section 名叫 noncacheable 并不会自动关闭 CPU DCache。
;     如果后续启用 DCache，还需要 MPU 非缓存区域配置，或者手动做 cache clean/invalidate。
;
; ---------------------------------------------------------------------------------------------------
; 预留给以后使用的 section 命名约定
; ---------------------------------------------------------------------------------------------------
;
;   .itcm_text*       从 Flash 加载，复制到 ITCM 执行的热点代码
;   .dtcm_data*       只给 CPU 使用的高速 DTCM 数据
;   .axi_dma*         明确要求放到 AXI SRAM 的 DMA 缓冲区
;   .d2_sram*         明确要求放到 D2 SRAM 的对象
;   .d3_sram*         明确要求放到 D3 SRAM 的对象
;   .bkpsram*         明确要求放到 Backup SRAM 的对象
;
; 当工程中第一次真正使用这些 section 时，再启用文件末尾对应的执行区。
; 如果提前启用但没有任何输入 section 匹配，armlink 会输出 L6314W 警告。

LR_IROM1 0x08000000 0x00200000  {       ; 加载区：整个镜像存放在 Flash 中

  ; Flash 执行区。
  ;
  ; RESET 必须放在最前面，因为镜像起始地址就是中断向量表。
  ; Cortex-M7 复位后会从该表中读取初始 SP 和 Reset_Handler。
  ; InRoot$$Sections 用于保留 C 运行库初始化时必须存在的根 section。
  ; 剩下的 RO 和 XO section 是直接在 Flash 中执行的代码和只读常量。
  ER_IROM1 0x08000000 0x00200000  {
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
   .ANY (+XO)
  }

  ; 启动/主栈，放在 DTCM 顶部 16KB。
  ;
  ; 这里的大小必须和 startup_stm32h743xx.s 里的 Stack_Size 保持一致。
  ; DTCM 延迟低，适合放 CPU 专用的栈数据；栈不需要外设 DMA 访问。
  ;
  ; 当前使用的 DTCM 范围：
  ;   0x2001C000-0x2001FFFF  16KB STACK
  RW_DTCM_STACK 0x2001C000 0x00004000  {
   startup_stm32h743xx.o (STACK)
  }

  ; 主 AXI SRAM 数据区。
  ;
  ; .noncacheable* 放在 .ANY 之前，因此显式标记的 USB/DMA 对象会被集中放在
  ; AXI SRAM 起始位置，而不会混在其他普通 RW/ZI 数据中。
  ; .ANY (+RW +ZI) 会接收所有前面没有匹配到的普通已初始化全局变量和零初始化全局变量。
  ;
  ; 当前使用的 AXI SRAM 范围：
  ;   0x24000000-0x2405FFFF  384KB RW/ZI 数据和 .noncacheable*
  RW_AXI 0x24000000 0x00060000  {
   *(.noncacheable*)
   .ANY (+RW +ZI)
  }

  ; C/C++ heap，放在 AXI SRAM 顶部 128KB。
  ;
  ; 这里的大小必须和 startup_stm32h743xx.s 里的 Heap_Size 保持一致。
  ; 单独划分 heap 执行区可以让 map 文件更容易阅读，也能避免 .ANY 消耗预留的 heap 空间。
  ;
  ; 当前使用的 AXI SRAM 范围：
  ;   0x24060000-0x2407FFFF  128KB HEAP
  RW_AXI_HEAP 0x24060000 0x00020000  {
   startup_stm32h743xx.o (HEAP)
  }

; 可选执行区示例：
;
; 只有工程里真的存在对应输入 section 时才启用。
; ARMClang C 代码中一种常见的声明方式如下：
;   __attribute__((section(".dtcm_data"))) uint8_t fast_buffer[1024];
;
; DMA 缓冲区优先放 AXI 或 D2 SRAM，并同时确认 cache 策略。
; DTCM 对 CPU 很快，但通常不适合外设 DMA。
;
;  ER_ITCM 0x00000000 0x00010000  {      ; 64KB ITCM，可选热点代码区
;   *(.itcm_text*)
;  }
;
;  RW_DTCM 0x20000000 0x0001C000  {      ; 112KB DTCM，可选 CPU 专用高速数据区
;   *(.dtcm_data*)
;  }
;
;  RW_D2_SRAM 0x30000000 0x00048000  {   ; 288KB D2 SRAM，使用 AHB 地址
;   *(.d2_sram*)
;  }
;
;  RW_D3_SRAM 0x38000000 0x00010000  {   ; 64KB D3 SRAM
;   *(.d3_sram*)
;  }
;
;  RW_BKPSRAM 0x38800000 0x00001000  {   ; 4KB Backup SRAM
;   *(.bkpsram*)
;  }
}
